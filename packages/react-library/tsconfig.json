{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
      "outDir": "./dist",
      "target": "ES2022",
      "useDefineForClassFields": true,
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "module": "esnext",
      "moduleResolution": "bundler",
      "skipLibCheck": true,
      "jsx": "react",
      "allowSyntheticDefaultImports": true,
      "declarationDir": "./dist/types"
    },
    "include": ["src"],
    "exclude": ["node_modules"]
  }