{
    "compilerOptions": {
      "module": "ESNext",
      "declaration": true,
      "noImplicitAny": false,
      "removeComments": true,
      "noLib": false,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "target": "ES2017",
      "sourceMap": true,
      "lib": ["ES2017"]
    },
    "exclude": ["node_modules", "**/*.spec.ts", "**/__tests__/**"]
  }