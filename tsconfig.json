{
    "compilerOptions": {
      "module": "esnext",
      "declaration": true,
      "noImplicitAny": false,
      "removeComments": true,
      "noLib": false,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "target": "es2022",
      "sourceMap": true,
      "lib": ["es2022"]
    },
    "exclude": ["node_modules", "**/*.spec.ts", "**/__tests__/**"]
